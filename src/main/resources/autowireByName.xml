<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here & initialize it using property tag(look for message and set message to that)-->
    <bean id="specification" class="car.autowire.byName.Specification">
        <property name="make" value="Hyundai"/>
        <property name="model" value="i20"/>
    </bean>

    <!-- It will go to car class and search by name "specification" exact in ID -->
    <bean id="myCar" class="car.autowire.byName.Car" autowire="byName"/>

</beans>